---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

const columns = [
  {
    heading: "Reference",
    links: [
      { label: "Knowledge Base", href: "/iceberg/" },
      { label: "Apache Iceberg Guide", href: "/apache-iceberg/" },
      { label: "Iceberg Architecture", href: "/apache-iceberg-architecture/" },
      { label: "The Data Lakehouse", href: "/data-lakehouse/" },
      { label: "Open Table Formats", href: "/open-table-formats/" },
    ],
  },
  {
    heading: "Read & watch",
    links: [
      { label: "All posts", href: "/posts/" },
      { label: "Video explainers", href: "/videos/" },
      { label: "Tags", href: "/tags/" },
      { label: "Search", href: "/search/" },
      { label: "RSS feed", href: "/rss.xml" },
    ],
  },
  {
    heading: "Community",
    links: [
      { label: "Slack", href: "https://bit.ly/lakehouse-hub-slack", ext: true },
      {
        label: "Events calendar",
        href: "https://lu.ma/Lakehouselinkups",
        ext: true,
      },
      {
        label: "Data Lakehouse Hub",
        href: "https://datalakehousehub.com",
        ext: true,
      },
      {
        label: "Lakehouse Blogs",
        href: "https://lakehouseblogs.com",
        ext: true,
      },
      { label: "About", href: "/about/" },
    ],
  },
];

const network = [
  {
    heading: "Free weekly newsletters",
    links: [
      {
        label: "AI newsletter, Thursdays",
        href: "https://amdatalakehouse.substack.com",
      },
      {
        label: "Apache lakehouse newsletter, Fridays",
        href: "https://amdatalakehouse.substack.com",
      },
      {
        label: "Subscribe on Substack",
        href: "https://amdatalakehouse.substack.com",
      },
    ],
  },
  {
    heading: "Alex Merced",
    links: [
      { label: "AlexMerced.com", href: "https://alexmerced.com" },
      { label: "WhoIsAlexMerced.com", href: "https://whoisalexmerced.com" },
      { label: "AlexMercedMedia.com", href: "https://alexmercedmedia.com" },
      { label: "Books", href: "https://books.alexmerced.com" },
      { label: "AlexMercedCoder.dev", href: "https://alexmercedcoder.dev" },
      { label: "AlexMercedData.com", href: "https://alexmerceddata.com" },
    ],
  },
  {
    heading: "Lakehouse & Data",
    links: [
      { label: "DataLakehouseHub.com", href: "https://datalakehousehub.com" },
      { label: "AgenticLakehouse.com", href: "https://agenticlakehouse.com" },
      {
        label: "AgenticAnalyticsNow.com",
        href: "https://agenticanalyticsnow.com",
      },
      {
        label: "OpenAgenticPlatform.com",
        href: "https://openagenticplatform.com",
      },
      { label: "AlexMercedAI.com", href: "https://www.alexmercedai.com" },
      { label: "SemanticLakehouse.com", href: "https://semanticlakehouse.com" },
      {
        label: "OpenLakehouse.AlexMerced.com",
        href: "https://openlakehouse.alexmerced.com",
      },
      { label: "DataEngnr.com", href: "https://dataengnr.com" },
    ],
  },
  {
    heading: "Blogs",
    links: [
      { label: "AlexMerced.blog", href: "https://alexmerced.blog" },
      { label: "GrokOverflow.com", href: "https://grokoverflow.com" },
      { label: "IngestThis.com", href: "https://ingestthis.com" },
      { label: "AlexMercedMusic.com", href: "https://alexmercedmusic.com" },
    ],
  },
];

const community = [
  {
    heading: "Event Calendars",
    links: [
      {
        label: "Agentic Lakehouse Events",
        href: "https://luma.com/agenticlakehouse",
      },
      {
        label: "Data Lakehouse Hub Events",
        href: "https://luma.com/DataLakehouseHub",
      },
    ],
  },
  {
    heading: "Communities",
    links: [
      {
        label: "Data Lakehouse Hub Slack",
        href: "https://join.slack.com/t/thedatalakehousehub/shared_invite/zt-274yc8sza-mI2zhCW8LGkOh1uxuf8T5Q",
      },
      {
        label: "Data Events Slack",
        href: "https://join.slack.com/t/data-events/shared_invite/zt-38vgrooy9-U9ral_gr3NAz_Siih1QwmQ",
      },
      {
        label: "Data & Tech Slack",
        href: "https://join.slack.com/t/datatechcommunity/shared_invite/zt-12xrk4qmd-y~6jUFFd7kdaLhgLURKwoA",
      },
      {
        label: "r/datalakehouseandai",
        href: "https://www.reddit.com/r/datalakehouseandai/",
      },
      {
        label: "Data Lakehouse Hub on LinkedIn",
        href: "https://www.linkedin.com/company/data-lakehouse-hub/",
      },
    ],
  },
  {
    heading: "YouTube",
    links: [
      {
        label: "Alex Merced Tech",
        href: "https://www.youtube.com/@AlexMercedCoder",
      },
      {
        label: "Alex Merced Data & AI",
        href: "https://www.youtube.com/@alexmerceddata",
      },
    ],
  },
];
---

<footer class={`${noMarginTop ? "" : "mt-auto"} w-full`}>
  <Hr noPadding />
  <div class="footer-wrapper">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">{SITE.title}</a>
        <p class="footer-tagline">{SITE.desc}</p>
        <Socials centered={false} />
      </div>

      {
        columns.map(col => (
          <nav class="footer-col" aria-label={col.heading}>
            <h2>{col.heading}</h2>
            <ul>
              {col.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    target={link.ext ? "_blank" : undefined}
                    rel={link.ext ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <nav class="footer-run" aria-label="The Alex Merced Network">
      <h2 class="footer-run-title">The Alex Merced Network</h2>
      <ul class="footer-run-list">
        {
          network
            .flatMap(col => col.links)
            .map(link => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <nav class="footer-run" aria-label="Events and community">
      <h2 class="footer-run-title">Events &amp; Community</h2>
      <ul class="footer-run-list">
        {
          community
            .flatMap(col => col.links)
            .map(link => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="footer-base">
      <p>
        &copy; {currentYear}{" "}
        {SITE.title}. Built for the data lakehouse community by <a
          href="https://alexmerced.com"
          rel="noopener noreferrer">Alex Merced</a
        >.
      </p>
      <p>
        Not affiliated with the Apache Software Foundation. The views expressed
        here belong solely to Alex Merced and do not represent any organization
        or employer.
      </p>
    </div>
  </div>
</footer>

<style>
  @reference "@styles/base.css";
  .footer-wrapper {
    @apply mx-auto max-w-5xl px-4 pb-10 pt-12;
  }
  .footer-grid {
    @apply grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr];
  }
  .footer-logo {
    @apply text-lg font-extrabold tracking-tight text-skin-base transition-colors hover:text-skin-accent;
  }
  .footer-tagline {
    @apply mb-4 mt-3 max-w-xs text-sm leading-relaxed opacity-70;
  }
  .footer-col h2 {
    @apply mb-3 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-skin-base opacity-60;
  }
  .footer-col ul {
    @apply space-y-2;
  }
  .footer-col a {
    @apply text-sm opacity-85 transition-colors hover:text-skin-accent hover:opacity-100;
  }
  .footer-run {
    @apply mt-8 border-t border-skin-line pt-6;
  }
  .footer-run-title {
    @apply mb-3 font-mono text-xs font-semibold uppercase tracking-[0.16em] text-skin-accent;
  }
  .footer-run-list {
    @apply flex list-none flex-wrap items-center gap-x-3 gap-y-2;
  }
  .footer-run-list a {
    @apply text-sm opacity-85 transition-colors hover:text-skin-accent hover:opacity-100;
  }
  .footer-run-list li + li::before {
    content: "\00B7";
    margin-right: 0.75rem;
    opacity: 0.5;
  }
  .footer-base {
    @apply mt-10 space-y-2 border-t border-skin-line pt-6;
  }
  .footer-base p {
    @apply text-xs leading-relaxed opacity-55;
  }
  .footer-base a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }

  /* Mobile: one item per row left a separator stranded at line start and tiny
     tap targets. Below 640px the run items become chips instead. */
  @media (max-width: 640px) {
    .footer-run-list {
      @apply gap-2;
    }
    .footer-run-list li + li::before {
      content: none !important;
      margin-right: 0 !important;
    }
    .footer-run-list a {
      @apply block max-w-full overflow-hidden text-ellipsis whitespace-nowrap rounded-md border border-skin-line px-3 py-2 leading-tight;
    }
  }
</style>
