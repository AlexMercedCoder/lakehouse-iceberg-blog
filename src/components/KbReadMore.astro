---
// KbReadMore.astro: posts on this site that cover a KB term, chosen at build
// time by kbMatch (title, tags, and repeated mentions in the body).
import { getKbIndex } from "@utils/kbIndex";

export interface Props {
  termSlug: string;
  term: string;
}

const { termSlug, term } = Astro.props;
const posts = (await getKbIndex()).postsForTerm(termSlug);
---

{
  posts.length > 0 && (
    <section class="kb-read-more" aria-label={`Articles about ${term}`}>
      <h2 class="kb-read-more-heading">Read more on this blog</h2>
      <ul>
        {posts.map(p => (
          <li>
            <a href={p.href}>{p.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  @reference "@styles/base.css";
  .kb-read-more {
    @apply mt-10 border-t border-skin-line pt-8;
  }
  .kb-read-more-heading {
    @apply mb-4 text-lg font-semibold text-skin-base;
  }
  .kb-read-more ul {
    @apply list-disc pl-5;
  }
  .kb-read-more li {
    @apply my-2;
  }
  .kb-read-more a {
    @apply text-skin-accent underline decoration-dashed underline-offset-4 hover:opacity-75;
  }
</style>
