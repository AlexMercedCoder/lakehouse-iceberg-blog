---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
  /** Canonical URL override for the current archive page. */
  canonicalURL?: string;
  /** Opt out pages that are intentionally unavailable to search engines. */
  noIndex?: boolean;
  /** Number of posts carrying this tag, across all pages. */
  postCount?: number;
  /** Titles of the newest posts with this tag, for the description. */
  sampleTitles?: string[];
}

const {
  currentPage,
  totalPages,
  paginatedPosts,
  tag,
  tagName,
  canonicalURL,
  noIndex = false,
  postCount = 0,
  sampleTitles = [],
} = Astro.props;

// Paginated tag pages and tags with fewer than 3 posts are thin: keep them out
// of the index (and the sitemap, see astro.config.ts) but let crawlers follow
// their links to the posts.
const thin = currentPage > 1 || postCount < 3;

// Describe the tag by what is on it: the count and the newest titles.
const countText = `${postCount} ${postCount === 1 ? "article" : "articles"} on ${tagName}`;
let description = `${countText} from Alex Merced, newest first.`;
for (let n = sampleTitles.length; n > 0; n--) {
  const list = sampleTitles
    .slice(0, n)
    .map(t => `"${t}"`)
    .join(" and ");
  const candidate = `${countText} from Alex Merced, newest first, including ${list}.`;
  if (candidate.length <= 160) {
    description = candidate;
    break;
  }
}
if (currentPage > 1) {
  description = `${countText} from Alex Merced, page ${currentPage} of ${totalPages}.`;
}
---

<Layout
  title={`Tag: ${tagName}${currentPage > 1 ? ` - Page ${currentPage}` : ""} | ${SITE.title}`}
  canonicalURL={canonicalURL}
  description={description}
  noIndex={noIndex}
  robots={thin ? "noindex, follow" : undefined}
>
  <Header activeNav="tags" />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`Articles tagged "${tagName}"${currentPage > 1 ? `, page ${currentPage}` : ""}.`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        paginatedPosts.map(({ data, id: slug, body }) => {
          const wordCount = body.split(/\s+/).length;
          const readingTime = `${Math.ceil(wordCount / 200)} MIN READ`;
          return (
            <Card
              href={`/posts/${slug.toLowerCase()}/`}
              frontmatter={data}
              readingTime={readingTime}
              tags={data.tags}
            />
          );
        })
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`/tags/${tag}/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
