---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import bookData from "../data/books.json";

const { intro, books, count, totalInCatalog, catalog } = bookData;
---

<Layout
  title={`Books by Alex Merced | ${SITE.title}`}
  description="Books on Apache Iceberg, lakehouse architecture, catalogs, and agentic analytics, written by Alex Merced."
>
  <Header activeNav="books" />

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <section class="pt-8 pb-6">
      <p class="text-sm uppercase tracking-wider text-skin-accent">
        Books by Alex Merced
      </p>
      <h1 class="text-2xl font-semibold sm:text-3xl">Read further</h1>
      <p class="mt-4">{intro}</p>
      <p class="mt-2 text-sm opacity-80">
        {count} of {totalInCatalog} titles.
        <a
          class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          href={catalog}
          target="_blank"
          rel="noopener noreferrer"
        >
          See the complete catalog
        </a>
      </p>
    </section>

    <ul>
      {
        books.map(book => (
          <li class="my-8 flex gap-5 border-b border-skin-line pb-8">
            <a
              href={book.canonicalPage}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              aria-hidden="true"
              class="w-24 shrink-0"
            >
              <img
                src={book.cover}
                alt=""
                loading="lazy"
                decoding="async"
                class="w-full rounded shadow-md"
              />
            </a>
            <div>
              <h2 class="text-lg font-medium decoration-dashed hover:underline">
                <a
                  href={book.canonicalPage}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {book.title}
                </a>
              </h2>
              {book.publisher && (
                <p class="text-xs uppercase tracking-wide opacity-70">
                  {book.publisher}
                </p>
              )}
              <p class="mt-2 text-sm">{book.description}</p>
              <p class="mt-3 flex flex-wrap gap-4 text-sm font-medium">
                <a
                  class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
                  href={book.canonicalPage}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Details
                </a>
                <a
                  class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
                  href={book.amazon}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Buy on Amazon
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />
</Layout>
