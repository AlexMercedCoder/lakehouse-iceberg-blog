---
// /videos/ — Apache Iceberg video explainer gallery.
// Silent, animated 16:9 explainers rendered from the shared HyperFrames template.
// The manifest is generated by the video workspace's sync-to-site.mjs.
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import IcebergCTA from "@components/IcebergCTA.astro";
import { SITE } from "@config";
import videos from "../../data/videos.json";

const canonicalURL = new URL("/videos/", Astro.site).href;
const abs = (p: string) => new URL(p, Astro.site).href;

const title = "Apache Iceberg Video Explainers";
const description =
  "Short animated explainers on Apache Iceberg: the table format itself, the V3 spec, compaction, merge-on-read, catalogs and the REST spec, interoperability, cost, and agentic AI.";

const UPLOAD_DATE = "2026-08-08";

const publisher = {
  "@type": "Organization",
  name: SITE.title,
  url: new URL("/", Astro.site).href,
};

const videoSchemas = videos.map(v => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${canonicalURL}#${v.slug}`,
  name: v.title,
  description: v.description,
  thumbnailUrl: [abs(v.poster)],
  uploadDate: UPLOAD_DATE,
  duration: v.iso8601,
  contentUrl: abs(v.src),
  encodingFormat: "video/mp4",
  width: v.width,
  height: v.height,
  inLanguage: "en",
  isFamilyFriendly: true,
  keywords: v.keywords.join(", "),
  creator: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
  },
  publisher,
}));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalURL}#collection`,
  name: title,
  description,
  url: canonicalURL,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: videos.length,
    itemListElement: videos.map((v, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${canonicalURL}#${v.slug}`,
      name: v.title,
    })),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    { "@type": "ListItem", position: 2, name: "Videos", item: canonicalURL },
  ],
};

const fmt = (s: number) =>
  `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
---

<Layout title={`${title} | ${SITE.title}`} {description} {canonicalURL}>
  {
    videoSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
  }
  <script
    type="application/ld+json"
    set:html={JSON.stringify(collectionSchema)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <Header activeNav="videos" />

  <nav class="video-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">Videos</span>
  </nav>

  <main id="main-content" class="video-main">
    <header class="video-hero">
      <p class="video-eyebrow">Video explainers</p>
      <h1>Apache Iceberg, explained in under a minute each</h1>
      <p class="video-lede">
        Eight short, animated explainers covering the ideas that come up most
        often when teams adopt Apache Iceberg. They are silent by design — every
        point is on screen, so they work with the sound off, in a meeting, or
        embedded in your own docs.
      </p>
    </header>

    {
      videos.length === 0 ? (
        <p class="video-empty">
          Videos are being published — check back shortly.
        </p>
      ) : (
        <ul class="video-grid" role="list">
          {videos.map(v => (
            <li class="video-card" id={v.slug}>
              <div class="video-frame">
                <video
                  class="video-el"
                  controls
                  muted
                  playsinline
                  preload="metadata"
                  poster={v.poster}
                  width={v.width}
                  height={v.height}
                  aria-label={`${v.title} — silent animated explainer, ${fmt(v.seconds)}`}
                >
                  <source src={v.src} type="video/mp4" />
                  Your browser does not support the video tag.
                  <a href={v.src}>Download the MP4</a>.
                </video>
                <span class="video-duration" aria-hidden="true">
                  {fmt(v.seconds)}
                </span>
              </div>

              <div class="video-body">
                <h2>
                  <span class="video-index">
                    {String(v.index).padStart(2, "0")}
                  </span>
                  {v.title}
                </h2>
                <p class="video-caption">{v.description}</p>
                <ul class="video-points" role="list">
                  {v.beats.map(b => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <p class="video-note">
      No audio track — these are kinetic-text explainers. Hover to preview,
      click to play.
    </p>

    <IcebergCTA />
  </main>

  <Footer />
</Layout>

<style>
  .video-breadcrumb {
    @apply mx-auto flex max-w-5xl items-center gap-2 px-4 pt-6 text-sm text-skin-base opacity-70;
  }
  .video-breadcrumb a {
    @apply hover:text-skin-accent hover:opacity-100;
  }
  .video-main {
    @apply mx-auto w-full max-w-5xl px-4 pb-16;
  }

  .video-hero {
    @apply mt-8 max-w-3xl;
  }
  .video-eyebrow {
    @apply font-mono text-xs uppercase tracking-[0.18em] text-skin-accent;
  }
  .video-hero h1 {
    @apply mt-3 text-3xl font-bold tracking-tight text-skin-base sm:text-4xl;
  }
  .video-lede {
    @apply mt-4 text-base leading-relaxed text-skin-base opacity-80 sm:text-lg;
  }

  .video-grid {
    @apply mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2;
  }
  .video-card {
    @apply flex flex-col overflow-hidden rounded-xl border border-skin-line bg-skin-card/40;
  }

  .video-frame {
    @apply relative w-full bg-[#04101c];
    aspect-ratio: 16 / 9;
  }
  .video-el {
    @apply absolute inset-0 block h-full w-full;
  }
  .video-duration {
    @apply pointer-events-none absolute right-2 top-2 rounded bg-black/65 px-2 py-1 font-mono text-xs text-white;
  }

  .video-body {
    @apply flex flex-1 flex-col p-5;
  }
  .video-body h2 {
    @apply flex items-baseline gap-2 text-lg font-semibold leading-snug text-skin-base;
  }
  .video-index {
    @apply font-mono text-sm text-skin-accent;
  }
  .video-caption {
    @apply mt-2 text-sm leading-relaxed text-skin-base opacity-75;
  }
  .video-points {
    @apply mt-4 flex flex-col gap-1.5 border-t border-skin-line pt-4;
  }
  .video-points li {
    @apply relative pl-4 text-sm text-skin-base opacity-70;
  }
  .video-points li::before {
    content: "";
    @apply absolute left-0 top-[0.6em] h-px w-2 bg-skin-accent;
  }

  .video-note {
    @apply mt-10 text-center text-sm text-skin-base opacity-60;
  }
  .video-empty {
    @apply mt-12 text-center text-skin-base opacity-70;
  }
</style>

<script>
  // Silent explainers: preview on hover, but hand control to the user the
  // moment they interact with the player.
  function setupVideoGallery() {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (reduce) return;

    document.querySelectorAll<HTMLVideoElement>(".video-el").forEach(video => {
      const release = () => {
        video.dataset.userControlled = "1";
      };
      video.addEventListener("click", release);
      video.addEventListener("keydown", release);

      video.addEventListener("pointerenter", event => {
        if (event.pointerType !== "mouse") return;
        if (video.dataset.userControlled) return;
        video.muted = true;
        void video.play().catch(() => {});
      });

      video.addEventListener("pointerleave", event => {
        if (event.pointerType !== "mouse") return;
        if (video.dataset.userControlled) return;
        video.pause();
        video.currentTime = 0;
      });
    });
  }

  setupVideoGallery();
  document.addEventListener("astro:after-swap", setupVideoGallery);
</script>
