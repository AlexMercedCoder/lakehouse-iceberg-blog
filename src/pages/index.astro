---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");
const icebergTerms = await getCollection("iceberg");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

// Rounded down so the figures stay true as the library grows.
const floorTo = (n: number, step: number) => Math.floor(n / step) * step;

const stats = [
  { value: `${floorTo(posts.length, 25)}+`, label: "Articles" },
  { value: `${floorTo(icebergTerms.length, 25)}+`, label: "Reference entries" },
  {
    value: `${new Set(icebergTerms.map(t => t.data.category)).size}`,
    label: "Subject areas",
  },
  { value: "Free", label: "No paywall, ever" },
];

// The pillar pages are this site's backbone. Surfacing them on the homepage
// gives readers a route in that isn't buried in the nav dropdown.
const topics = [
  {
    title: "Apache Iceberg",
    blurb:
      "The metadata tree, snapshots, hidden partitioning, and the catalog API — end to end.",
    href: "/apache-iceberg/",
    tag: "Pillar guide",
  },
  {
    title: "Iceberg Architecture",
    blurb:
      "How manifest lists, manifest files, and data files fit together at query time.",
    href: "/apache-iceberg-architecture/",
    tag: "Deep dive",
  },
  {
    title: "The REST Catalog",
    blurb:
      "What the Iceberg REST Catalog spec standardises, and how engines authenticate against it.",
    href: "/apache-iceberg-rest-catalog/",
    tag: "Catalogs",
  },
  {
    title: "Snapshots & Time Travel",
    blurb:
      "Atomic commits, snapshot expiration, rollback, and querying a table as of any point in time.",
    href: "/apache-iceberg-snapshots-and-time-travel/",
    tag: "Deep dive",
  },
  {
    title: "Schema Evolution",
    blurb:
      "Add, drop, rename, and reorder columns safely — and why Iceberg's field IDs make it work.",
    href: "/apache-iceberg-schema-evolution/",
    tag: "Deep dive",
  },
  {
    title: "Iceberg vs Delta Lake vs Hudi",
    blurb:
      "A neutral comparison of the three open table formats across design, features, and ecosystem.",
    href: "/apache-iceberg-vs-delta-lake-vs-hudi/",
    tag: "Comparison",
  },
  {
    title: "The Data Lakehouse",
    blurb:
      "What a lakehouse actually is, the layers it is built from, and how it differs from a warehouse.",
    href: "/data-lakehouse/",
    tag: "Pillar guide",
  },
  {
    title: "The Agentic Lakehouse",
    blurb:
      "Semantic layers, MCP, and the architecture AI agents need to query your data reliably.",
    href: "/agentic-lakehouse/",
    tag: "Agentic AI",
  },
  {
    title: "Open Table Formats",
    blurb:
      "Why table formats exist at all, and the problems they solved for data lakes.",
    href: "/open-table-formats/",
    tag: "Foundations",
  },
];

const mustReads = [
  {
    title: "The Definitive Guide to the Semantic Layer",
    description:
      "Understand what a semantic layer is, why it matters for modern data architectures, and how it creates a consistent, governed layer between raw data and business consumers.",
    href: "https://www.dremio.com/blog/semantic-layer-the-definitive-guide/",
  },
  {
    title: "Apache Polaris: The Catalog Standard for Lakehouses and AI",
    description:
      "A deep dive into Apache Polaris, the open-source catalog that is emerging as the standard for managing Iceberg tables across multi-engine Lakehouses and AI workloads.",
    href: "https://www.dremio.com/blog/apache-polaris-the-catalog-standard-for-lakehouses-and-ai/",
  },
  {
    title: "What Are Table Formats and Why Were They Needed?",
    description:
      "Explore the history and motivations behind open table formats like Apache Iceberg, Delta Lake, and Apache Hudi, and why they solved critical problems in big data engineering.",
    href: "https://www.dremio.com/blog/what-are-table-formats-and-why-were-they-needed/",
  },
  {
    title: "What is Dremio?",
    description:
      "A comprehensive overview of Dremio's Lakehouse platform — how it unifies data access, accelerates queries, and powers self-service analytics across cloud and on-premise sources.",
    href: "https://www.dremio.com/blog/what-is-dremio/",
  },
  {
    title: "What Apache Iceberg Native Actually Means",
    description:
      "Not all Iceberg integrations are equal. This article breaks down what it truly means for a platform to be 'Apache Iceberg native' and why the distinction matters for your architecture.",
    href: "https://www.dremio.com/blog/what-apache-iceberg-native-actually-means/",
  },
  {
    title: "Open Source and the Data Lakehouse",
    description:
      "A survey of the open source ecosystem powering modern Data Lakehouses — from Apache Iceberg and Nessie to Apache Arrow and Spark — and how they work together.",
    href: "https://www.dremio.com/blog/open-source-and-the-data-lakehouse/",
  },
  {
    title: "What is Agentic Analytics?",
    description:
      "Discover how AI agents are transforming analytics pipelines — autonomously querying data, generating insights, and taking actions — and what it means for the future of the Lakehouse.",
    href: "https://www.dremio.com/blog/what-is-agentic-analytics/",
  },
];
---

<Layout>
  <Header />
  <main id="main-content">
    <!-- ─────────────────────────── Hero ─────────────────────────── -->
    <section id="hero">
      <div class="hero-panel">
        <div class="grid-lines hero-grid" aria-hidden="true"></div>

        <div class="hero-inner">
          <span class="eyebrow">
            <span class="pulse-dot" aria-hidden="true"></span>
            Independent technical reference
          </span>

          <h1>
            The Apache Iceberg &amp;<br class="hidden sm:inline" />
            <span class="text-skin-accent">Lakehouse</span> encyclopedia
          </h1>

          <p class="hero-lede">
            Definitive reference material on Apache Iceberg, lakehouse catalogs,
            the agentic lakehouse, and modern data architecture. Whether you are
            learning what table formats are, deploying Apache Polaris, or wiring
            an engine to Iceberg tables, the answer is here — free, and written
            by a practitioner.
          </p>

          <div class="hero-actions">
            <a href="/iceberg/" class="btn-accent">
              Browse the Knowledge Base
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="!h-4 !w-4 !fill-transparent"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a href="/apache-iceberg/" class="btn-ghost">
              Start with the Iceberg guide
            </a>
            <a href="/search/" class="btn-ghost" aria-label="Search the site">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="!h-4 !w-4 !fill-transparent"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              Search
            </a>
          </div>

          <dl class="hero-stats">
            {
              stats.map(stat => (
                <div>
                  <dt>{stat.value}</dt>
                  <dd>{stat.label}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="hero-meta">
        <a
          target="_blank"
          href="/rss.xml"
          class="meta-link"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
            ><path
              d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
            ></path><path
              d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
            ></path><circle cx="6" cy="18" r="2"></circle>
          </svg>
          <span>RSS</span>
        </a>
        {
          socialCount > 0 && (
            <div class="social-wrapper">
              <span class="social-links">Follow along:</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <!-- ───────────────────────── Browse by topic ───────────────────────── -->
    <section id="topics">
      <div class="section-head">
        <span class="eyebrow">Start here</span>
        <h2>Browse by topic</h2>
        <p>
          Nine long-form pillar guides that cover the lakehouse stack from the
          file format up to the agents querying it.
        </p>
      </div>

      <ul class="topic-grid">
        {
          topics.map(topic => (
            <li>
              <a href={topic.href} class="panel panel-hover topic-card group">
                <span class="topic-tag">{topic.tag}</span>
                <h3>{topic.title}</h3>
                <p>{topic.blurb}</p>
                <span class="topic-cta">
                  Read the guide
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="!h-4 !w-4 !fill-transparent"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ───────────────────────── Featured posts ───────────────────────── -->
    {
      featuredPosts.length > 0 && (
        <section id="featured">
          <div class="section-head">
            <span class="eyebrow">Editor's picks</span>
            <h2>Featured</h2>
          </div>
          <ul class="post-grid">
            {featuredPosts.map(({ data, slug, body }) => {
              const wordCount = body.split(/\s+/).length;
              const readingTime = `${Math.ceil(wordCount / 200)} MIN READ`;
              return (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                  readingTime={readingTime}
                  tags={data.tags}
                />
              );
            })}
          </ul>
        </section>
      )
    }

    <!-- ───────────────────────── Recent posts ───────────────────────── -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <div class="section-head">
            <span class="eyebrow">From the blog</span>
            <h2>Recent Posts</h2>
          </div>
          <ul class="post-grid">
            {recentPosts.map(
              ({ data, slug, body }, index) =>
                index < SITE.postPerIndex && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                    readingTime={`${Math.ceil(body.split(/\s+/).length / 200)} MIN READ`}
                    tags={data.tags}
                  />
                )
            )}
          </ul>
          <div class="all-posts-btn-wrapper">
            <LinkButton href="/posts/" className="btn-ghost !text-skin-base">
              Browse all posts
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="!h-4 !w-4 !fill-transparent"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </LinkButton>
          </div>
        </section>
      )
    }

    <!-- ───────────────────────── Community ───────────────────────── -->
    <section id="community">
      <div class="community-panel">
        <div class="grid-lines hero-grid" aria-hidden="true"></div>
        <div class="community-inner">
          <div>
            <span class="eyebrow">Join in</span>
            <h2>Learn alongside the rest of the community</h2>
            <p>
              A Slack workspace for lakehouse practitioners, plus a shared
              calendar of meetups, webinars, and Lakehouse Linkups.
            </p>
          </div>
          <div class="community-actions">
            <a
              href="https://bit.ly/lakehouse-hub-slack"
              class="btn-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              Join the Slack community
            </a>
            <a
              href="https://lu.ma/Lakehouselinkups"
              class="btn-ghost"
              target="_blank"
              rel="noopener noreferrer"
            >
              Subscribe to the event calendar
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── Must reads ───────────────────────── -->
    <section id="must-reads">
      <div class="section-head">
        <span class="eyebrow">Elsewhere on the web</span>
        <h2>Must reads on Iceberg, agentic AI, and the lakehouse</h2>
      </div>
      <ul class="must-reads-grid">
        {
          mustReads.map(({ title, description, href }) => (
            <li class="panel panel-hover must-read-card">
              <h3 class="must-read-title">{title}</h3>
              <p class="must-read-desc">{description}</p>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="must-read-btn"
              >
                Read article
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="disclaimer">
      <p>
        Iceberg Lakehouse is an independent publication. It is not affiliated
        with the Apache Software Foundation or the Apache Iceberg project, whose
        official home is <a
          href="https://iceberg.apache.org"
          target="_blank"
          rel="noopener noreferrer">iceberg.apache.org</a
        >.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Shared section heading ===== */
  .section-head {
    @apply mb-7 max-w-2xl;
  }
  .section-head h2 {
    @apply mt-3 text-2xl font-bold tracking-tight sm:text-3xl;
  }
  .section-head p {
    @apply mt-3 text-[15px] leading-relaxed opacity-80;
  }

  .pulse-dot {
    @apply h-1.5 w-1.5 animate-pulse rounded-full bg-skin-accent;
  }

  /* ===== Hero ===== */
  #hero {
    @apply pb-4 pt-8;
  }
  .hero-panel {
    @apply relative overflow-hidden rounded-2xl border border-skin-line bg-skin-card
      px-6 py-12 sm:px-10 sm:py-16;
  }
  .hero-grid {
    @apply pointer-events-none absolute inset-0 opacity-70;
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 35%, transparent 78%);
  }
  .hero-inner {
    @apply relative;
  }
  #hero h1 {
    @apply mt-5 text-3xl font-extrabold leading-[1.12] tracking-tight sm:text-5xl;
  }
  .hero-lede {
    @apply mt-5 max-w-2xl text-base leading-relaxed opacity-85 sm:text-lg;
  }
  .hero-actions {
    @apply mt-8 flex flex-wrap gap-3;
  }
  .hero-stats {
    @apply mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-skin-line pt-8 sm:grid-cols-4;
  }
  .hero-stats dt {
    @apply font-mono text-2xl font-semibold tracking-tight text-skin-accent;
  }
  .hero-stats dd {
    @apply mt-1 text-xs font-medium uppercase tracking-wider opacity-70;
  }

  .hero-meta {
    @apply mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between;
  }
  .meta-link {
    @apply inline-flex items-center gap-2 text-sm font-medium opacity-80 hover:text-skin-accent hover:opacity-100;
  }
  .rss-icon {
    @apply h-4 w-4 fill-skin-accent;
  }
  .social-wrapper {
    @apply flex flex-wrap items-center gap-x-2;
  }
  .social-links {
    @apply whitespace-nowrap text-sm font-medium opacity-70;
  }

  /* ===== Topic grid ===== */
  #topics,
  #featured,
  #recent-posts,
  #community,
  #must-reads {
    @apply pb-6 pt-14;
  }
  .topic-grid {
    @apply grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3;
  }
  .topic-card {
    @apply flex h-full flex-col p-5 no-underline;
  }
  .topic-tag {
    @apply font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-skin-accent opacity-90;
  }
  .topic-card h3 {
    @apply mt-2.5 text-lg font-bold leading-snug tracking-tight;
  }
  .topic-card p {
    @apply mt-2 flex-1 text-sm leading-relaxed opacity-75;
  }
  .topic-cta {
    @apply mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-skin-accent;
  }
  .topic-card:hover .topic-cta svg {
    @apply translate-x-1;
  }
  .topic-cta svg {
    @apply transition-transform duration-200;
  }

  /* ===== Post grids ===== */
  .post-grid {
    @apply grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3;
  }
  .all-posts-btn-wrapper {
    @apply mt-8;
  }

  /* ===== Community band ===== */
  .community-panel {
    @apply relative overflow-hidden rounded-2xl border border-skin-line bg-skin-card-muted px-6 py-10 sm:px-10;
  }
  .community-inner {
    @apply relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between;
  }
  .community-inner h2 {
    @apply mt-3 max-w-lg text-2xl font-bold tracking-tight sm:text-3xl;
  }
  .community-inner > div > p {
    @apply mt-3 max-w-lg text-[15px] leading-relaxed opacity-80;
  }
  .community-actions {
    @apply flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col;
  }

  /* ===== Must Reads ===== */
  .must-reads-grid {
    @apply grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3;
  }
  .must-read-card {
    @apply flex flex-col p-5;
  }
  .must-read-title {
    @apply mb-2 text-base font-bold leading-snug tracking-tight;
  }
  .must-read-desc {
    @apply mb-4 flex-1 text-sm leading-relaxed opacity-75;
  }
  .must-read-btn {
    @apply inline-flex items-center gap-1 self-start rounded-md border border-skin-line px-3 py-1.5
      text-xs font-semibold text-skin-accent transition-colors
      hover:border-skin-accent hover:bg-skin-accent hover:text-skin-inverted;
  }
  .must-read-btn:hover svg {
    @apply fill-skin-inverted;
  }

  /* ===== Disclaimer ===== */
  #disclaimer {
    @apply pb-10 pt-8;
  }
  #disclaimer p {
    @apply border-t border-skin-line pt-6 text-xs leading-relaxed opacity-60;
  }
  #disclaimer a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
</style>
